{
  "type": "module",
  "version": "1.62.2",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --mode=dev",
    "serve": "node serve.mjs",
    "test": "node --test test/*.test.js",
    "test:ui": "node --loader ./test/helpers/jsx-loader.mjs --test test/components/*.test.jsx",
    "test:e2e": "node test/e2e/run.mjs",
    "test:e2e:node": "node test/e2e/run.mjs node",
    "test:e2e:browser": "node test/e2e/run.mjs browser",
    "test:e2e:matrix": "node test/e2e/run-matrix.mjs",
    "test:e2e:container": "node scripts/e2e-container.mjs",
    "bench": "node perf/bench-algorithms.mjs",
    "perftest": "node perf/run.mjs",
    "deadcode": "node scripts/deadcode-gate.mjs",
    "deadcode:css": "node scripts/check-unused-css.mjs",
    "lint": "oxlint src/",
    "lint:fix": "oxlint --fix src/",
    "audit": "npm audit --omit=dev",
    "complexity": "oxlint src/ -c .oxlintrc.complexity.json",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"test/**/*.{js,jsx,mjs}\" \"scripts/**/*.mjs\" \"*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\" \"test/**/*.{js,jsx,mjs}\" \"scripts/**/*.mjs\" \"*.mjs\"",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null; git config push.followTags true 2>/dev/null; true"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1051.0",
    "@aws-sdk/s3-request-presigner": "^3.1051.0",
    "preact": "^10.29.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "knip": "6.35.1",
    "oxlint": "1.82.0",
    "playwright": "^1.60.0",
    "prettier": "3.9.6",
    "purgecss": "8.0.0"
  }
}
